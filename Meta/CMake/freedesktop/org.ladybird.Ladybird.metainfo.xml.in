<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2025-present, the Ladybird developers. -->
<component type="desktop-application">
  <id>io.github.anwarulislam.Ladyarc</id>

  <name>Ladyarc</name>
  <summary>Browse in Spaces with the Ladybird engine</summary>

  <developer id="io.github.anwarulislam">
    <name>Ladyarc contributors</name>
  </developer>

  <url type="homepage">https://github.com/anwarulislam/ladyarc</url>
  <url type="bugtracker">https://github.com/anwarulislam/ladyarc/issues</url>
  <url type="vcs-browser">https://github.com/anwarulislam/ladyarc</url>

  <metadata_license>0BSD</metadata_license>
  <project_license>BSD-2-Clause</project_license>
  <content_rating type="oars-1.1" />

  <description>
    <p>
      Ladyarc uses the Ladybird browser engine. Organize tabs into Spaces, preview links with Peek, and open external links in a Little Arc window.
    </p>
  </description>

  <provides>
    <mediatype>text/html</mediatype>
    <mediatype>text/xml</mediatype>
    <mediatype>application/xhtml+xml</mediatype>
    <mediatype>x-scheme-handler/http</mediatype>
    <mediatype>x-scheme-handler/https</mediatype>
  </provides>

  <launchable type="desktop-id">io.github.anwarulislam.Ladyarc.desktop</launchable>
  <releases>
    <release version="@METAINFO_RELEASE_VERSION@" type="@METAINFO_RELEASE_TYPE@" date="@DATE@">
      <description>
        <p>
          @METAINFO_RELEASE_DESCRIPTION@
        </p>
      </description>
    </release>
  </releases>

  <branding>
    <color type="primary" scheme_preference="light">#9d7cf2</color>
    <color type="primary" scheme_preference="dark">#8a64e5</color>
  </branding>

</component>
